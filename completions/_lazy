#compdef lazy
# Zsh completion for lazy CLI
# Install: copy to a directory in $fpath (e.g., /usr/local/share/zsh/site-functions/)

_lazy() {
    local context state state_descr line
    typeset -A opt_args

    _arguments -C \
        '1: :_lazy_commands' \
        '*::arg:->args'

    case $state in
        args)
            case $line[1] in
                pdf)
                    _lazy_pdf
                    ;;
                image)
                    _lazy_image
                    ;;
                video)
                    _lazy_video
                    ;;
                backup)
                    _lazy_backup
                    ;;
            esac
            ;;
    esac
}

_lazy_commands() {
    local commands=(
        'pdf:PDF operations (compress, merge)'
        'image:Image operations (convert/resize)'
        'video:Video operations (convert to MP4)'
        'backup:Backup operations (home)'
        'doctor:Check system dependencies'
        'version:Show version'
        'help:Show help'
    )
    _describe 'command' commands
}

_lazy_pdf() {
    local context state state_descr line
    typeset -A opt_args

    _arguments -C \
        '1: :_lazy_pdf_commands' \
        '*::arg:->args'

    case $state in
        args)
            case $line[1] in
                compress)
                    _lazy_pdf_compress
                    ;;
                merge)
                    _lazy_pdf_merge
                    ;;
            esac
            ;;
    esac
}

_lazy_pdf_commands() {
    local commands=(
        'compress:Compress a PDF file'
        'merge:Merge multiple PDF files'
    )
    _describe 'pdf command' commands
}

_lazy_pdf_compress() {
    _arguments \
        '(-q --quality)'{-q,--quality}'[Compression quality]:quality:(screen ebook printer prepress)' \
        '(-o --output)'{-o,--output}'[Output file]:output file:_files -g "*.pdf"' \
        '*:input file:_files -g "*.pdf"'
}

_lazy_pdf_merge() {
    _arguments \
        '(-o --output)'{-o,--output}'[Output file]:output file:_files -g "*.pdf"' \
        '*:input files:_files -g "*.pdf"'
}

_lazy_image() {
    local context state state_descr line
    typeset -A opt_args

    _arguments -C \
        '1: :_lazy_image_commands' \
        '*::arg:->args'

    case $state in
        args)
            case $line[1] in
                convert)
                    _lazy_image_convert
                    ;;
            esac
            ;;
    esac
}

_lazy_image_commands() {
    local commands=(
        'convert:Convert and/or resize one or more images'
    )
    _describe 'image command' commands
}

_lazy_image_convert() {
    _arguments \
        '(-f --format)'{-f,--format}'[Output format]:format:(jpg jpeg png webp gif bmp tiff)' \
        '(-q --quality)'{-q,--quality}'[Quality (1-100, default 85)]:quality:' \
        '(-r --resize)'{-r,--resize}'[Resize percentage]:resize:' \
        '(-s --size)'{-s,--size}'[Exact dimensions (WxH)]:size:' \
        '(-w --width)'{-w,--width}'[Width (maintain aspect ratio)]:width:' \
        '(-h --height)'{-h,--height}'[Height (maintain aspect ratio)]:height:' \
        '(-g --gray)'{-g,--gray}'[Convert to grayscale]' \
        '(-o --output)'{-o,--output}'[Output file (single input only)]:output file:_files' \
        '*:input files:_files -g "*.(png|jpg|jpeg|gif|webp|bmp|tiff)"'
}

_lazy_video() {
    local context state state_descr line
    typeset -A opt_args

    _arguments -C \
        '1: :_lazy_video_commands' \
        '*::arg:->args'

    case $state in
        args)
            case $line[1] in
                convert)
                    _lazy_video_convert
                    ;;
            esac
            ;;
    esac
}

_lazy_video_commands() {
    local commands=(
        'convert:Convert videos to MP4 (H.265/H.264, optional resolution cap)'
    )
    _describe 'video command' commands
}

_lazy_video_convert() {
    _arguments \
        '(-m --mode)'{-m,--mode}'[Compression mode]:mode:(balanced small quality)' \
        '(-c --codec)'{-c,--codec}'[Video codec]:codec:(h265 h264)' \
        '(-r --resolution)'{-r,--resolution}'[Target resolution]:resolution:(input 4k 1080p 720p)' \
        '*:input files:_files -g "*.(mov|avi|mkv|wmv|flv|webm|mp4|m4v|mpg|mpeg|3gp)"'
}

_lazy_backup() {
    local context state state_descr line
    typeset -A opt_args

    _arguments -C \
        '1: :_lazy_backup_commands' \
        '*::arg:->args'

    case $state in
        args)
            case $line[1] in
                home)
                    _lazy_backup_home
                    ;;
            esac
            ;;
    esac
}

_lazy_backup_commands() {
    local commands=(
        'home:Backup home directory to external volume'
    )
    _describe 'backup command' commands
}

_lazy_backup_home() {
    _arguments \
        '(-n --dry-run)'{-n,--dry-run}'[Show what would be transferred without doing it]' \
        '*:volume path:_files -/'
}

_lazy "$@"
