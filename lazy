#!/usr/bin/env bash
#
# lazy - A CLI tool for common file operations using ghostscript and imagemagick
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERSION="0.3.0"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Helper functions
info() { echo -e "${BLUE}[INFO]${NC} $*"; }
success() { echo -e "${GREEN}[OK]${NC} $*"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }
die() { error "$*"; exit 1; }

# Check if a command exists
require_cmd() {
    local cmd="$1"
    if ! command -v "$cmd" &> /dev/null; then
        die "$cmd is not installed. Run 'make install-deps' to install dependencies."
    fi
}

# Confirm before overwriting an existing file
confirm_overwrite() {
    local file="$1"
    if [[ -f "$file" ]]; then
        warn "File already exists: $file"
        read -r -p "Overwrite? [y/N] " response
        case "$response" in
            [yY][eE][sS]|[yY])
                return 0
                ;;
            *)
                die "Aborted."
                ;;
        esac
    fi
}

# Detect OS
detect_os() {
    case "$(uname -s)" in
        Darwin*) echo "macos" ;;
        Linux*)  echo "linux" ;;
        *)       echo "unknown" ;;
    esac
}

# Imagemagick convert wrapper with common parameters
# Usage: img_convert <input> [options...] <output>
# Applies: -strip (remove metadata), -interlace Plane (progressive loading)
img_convert() {
    convert -strip -interlace Plane "$@"
}

# Config file management
CONFIG_DIR="${HOME}/.config/lazy"
CONFIG_FILE="${CONFIG_DIR}/config"

config_get() {
    local key="$1"
    local default="${2:-}"
    if [[ -f "$CONFIG_FILE" ]]; then
        local value
        value=$(grep "^${key}=" "$CONFIG_FILE" 2>/dev/null | cut -d'=' -f2-)
        if [[ -n "$value" ]]; then
            echo "$value"
            return
        fi
    fi
    echo "$default"
}

config_set() {
    local key="$1"
    local value="$2"
    mkdir -p "$CONFIG_DIR"
    if [[ -f "$CONFIG_FILE" ]] && grep -q "^${key}=" "$CONFIG_FILE" 2>/dev/null; then
        # Update existing key
        sed -i.bak "s|^${key}=.*|${key}=${value}|" "$CONFIG_FILE" && rm -f "${CONFIG_FILE}.bak"
    else
        # Add new key
        echo "${key}=${value}" >> "$CONFIG_FILE"
    fi
}

# ============================================================================
# PDF Commands (using ghostscript)
# ============================================================================

cmd_pdf_compress() {
    local input=""
    local output=""
    local quality="ebook"  # screen, ebook, printer, prepress

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -q|--quality)
                quality="$2"
                shift 2
                ;;
            -o|--output)
                output="$2"
                shift 2
                ;;
            -*)
                die "Unknown option: $1"
                ;;
            *)
                input="$1"
                shift
                ;;
        esac
    done

    [[ -z "$input" ]] && die "Usage: lazy pdf compress <input.pdf> [-o output.pdf] [-q quality]

Quality options:
  screen   - lowest quality, smallest size (72 dpi)
  ebook    - medium quality, good for reading (150 dpi) [default]
  printer  - high quality for printing (300 dpi)
  prepress - highest quality, preserves color (300 dpi)"

    [[ ! -f "$input" ]] && die "File not found: $input"

    require_cmd gs

    # Default output name
    if [[ -z "$output" ]]; then
        local basename="${input%.*}"
        local ext="${input##*.}"
        output="${basename}_compressed.${ext}"
    fi

    confirm_overwrite "$output"

    info "Compressing $input -> $output (quality: $quality)"

    gs -sDEVICE=pdfwrite \
       -dCompatibilityLevel=1.4 \
       -dPDFSETTINGS="/$quality" \
       -dNOPAUSE \
       -dQUIET \
       -dBATCH \
       -sOutputFile="$output" \
       "$input"

    local input_size=$(stat -f%z "$input" 2>/dev/null || stat -c%s "$input")
    local output_size=$(stat -f%z "$output" 2>/dev/null || stat -c%s "$output")
    local reduction=$(( (input_size - output_size) * 100 / input_size ))

    success "Compressed: $(numfmt --to=iec $input_size 2>/dev/null || echo "${input_size} bytes") -> $(numfmt --to=iec $output_size 2>/dev/null || echo "${output_size} bytes") (${reduction}% reduction)"
}

cmd_pdf_merge() {
    local output=""
    local inputs=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -o|--output)
                output="$2"
                shift 2
                ;;
            -*)
                die "Unknown option: $1"
                ;;
            *)
                inputs+=("$1")
                shift
                ;;
        esac
    done

    [[ ${#inputs[@]} -lt 2 ]] && die "Usage: lazy pdf merge <input1.pdf> <input2.pdf> ... -o output.pdf"
    [[ -z "$output" ]] && die "Output file required. Use -o <output.pdf>"

    require_cmd gs
    confirm_overwrite "$output"

    info "Merging ${#inputs[@]} PDFs -> $output"

    gs -dBATCH \
       -dNOPAUSE \
       -dQUIET \
       -sDEVICE=pdfwrite \
       -sOutputFile="$output" \
       "${inputs[@]}"

    success "Created $output"
}

cmd_pdf() {
    local subcmd="${1:-}"
    shift || true

    case "$subcmd" in
        compress) cmd_pdf_compress "$@" ;;
        merge)    cmd_pdf_merge "$@" ;;
        *)
            echo "Usage: lazy pdf <command>

Commands:
  compress   Compress a PDF file
  merge      Merge multiple PDF files"
            if [[ -n "$subcmd" ]]; then
                die "Unknown command: pdf $subcmd"
            fi
            ;;
    esac
}

# ============================================================================
# Image Commands (using imagemagick)
# ============================================================================

cmd_image_resize() {
    local input=""
    local output=""
    local size=""
    local width=""
    local height=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -o|--output)
                output="$2"
                shift 2
                ;;
            -s|--size)
                size="$2"
                shift 2
                ;;
            -w|--width)
                width="$2"
                shift 2
                ;;
            -h|--height)
                height="$2"
                shift 2
                ;;
            -*)
                die "Unknown option: $1"
                ;;
            *)
                input="$1"
                shift
                ;;
        esac
    done

    [[ -z "$input" ]] && die "Usage: lazy image resize <input> [-o output] [-s WxH | -w width | -h height]

Options:
  -s, --size WxH      Resize to exact dimensions (e.g., 800x600)
  -w, --width N       Resize to width, maintain aspect ratio
  -h, --height N      Resize to height, maintain aspect ratio
  -o, --output FILE   Output file (default: input_resized.ext)"

    [[ ! -f "$input" ]] && die "File not found: $input"

    require_cmd convert

    # Default output name
    if [[ -z "$output" ]]; then
        local basename="${input%.*}"
        local ext="${input##*.}"
        output="${basename}_resized.${ext}"
    fi

    local geometry=""
    if [[ -n "$size" ]]; then
        geometry="$size!"
    elif [[ -n "$width" ]]; then
        geometry="${width}x"
    elif [[ -n "$height" ]]; then
        geometry="x${height}"
    else
        die "Specify -s, -w, or -h for resize dimensions"
    fi

    confirm_overwrite "$output"

    info "Resizing $input -> $output ($geometry)"

    img_convert "$input" -resize "$geometry" "$output"

    success "Created $output"
}

cmd_image_convert() {
    local input=""
    local output=""
    local quality=""
    local grayscale=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -o|--output)
                output="$2"
                shift 2
                ;;
            -q|--quality)
                quality="$2"
                shift 2
                ;;
            -g|--gray)
                grayscale="1"
                shift
                ;;
            -*)
                die "Unknown option: $1"
                ;;
            *)
                input="$1"
                shift
                ;;
        esac
    done

    [[ -z "$input" ]] && die "Usage: lazy image convert <input> -o <output> [-q quality] [-g]

Output format is determined by the output file extension.

Options:
  -o, --output FILE   Output file (required)
  -q, --quality N     Quality 1-100, applies to JPEG/WebP formats
  -g, --gray          Convert to grayscale"

    [[ ! -f "$input" ]] && die "File not found: $input"
    [[ -z "$output" ]] && die "Output file required. Use -o <output>"

    require_cmd convert
    confirm_overwrite "$output"

    local gray_info=""
    [[ -n "$grayscale" ]] && gray_info=", grayscale"
    info "Converting $input -> $output${gray_info}"

    local quality_args=()
    if [[ -n "$quality" ]]; then
        quality_args=(-quality "$quality")
    fi

    local gray_args=()
    if [[ -n "$grayscale" ]]; then
        gray_args=(-colorspace Gray)
    fi

    img_convert "$input" "${gray_args[@]}" "${quality_args[@]}" "$output"

    success "Created $output"
}

cmd_image_optimize() {
    local input=""
    local output=""
    local quality="85"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -o|--output)
                output="$2"
                shift 2
                ;;
            -q|--quality)
                quality="$2"
                shift 2
                ;;
            -*)
                die "Unknown option: $1"
                ;;
            *)
                input="$1"
                shift
                ;;
        esac
    done

    [[ -z "$input" ]] && die "Usage: lazy image optimize <input> [-o output] [-q quality]

Optimizes image file size while maintaining reasonable quality.
Quality: 1-100, default 85"

    [[ ! -f "$input" ]] && die "File not found: $input"

    require_cmd convert

    # Default output name
    if [[ -z "$output" ]]; then
        local basename="${input%.*}"
        local ext="${input##*.}"
        output="${basename}_optimized.${ext}"
    fi

    confirm_overwrite "$output"

    info "Optimizing $input -> $output (quality: $quality)"

    img_convert "$input" -quality "$quality" "$output"

    local input_size=$(stat -f%z "$input" 2>/dev/null || stat -c%s "$input")
    local output_size=$(stat -f%z "$output" 2>/dev/null || stat -c%s "$output")
    local reduction=$(( (input_size - output_size) * 100 / input_size ))

    success "Optimized: $(numfmt --to=iec $input_size 2>/dev/null || echo "${input_size} bytes") -> $(numfmt --to=iec $output_size 2>/dev/null || echo "${output_size} bytes") (${reduction}% reduction)"
}

cmd_image_batch_convert() {
    local quality="85"
    local format="jpg"
    local resize=""
    local grayscale=""
    local inputs=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -q|--quality)
                quality="$2"
                shift 2
                ;;
            -f|--format)
                format="$2"
                shift 2
                ;;
            -r|--resize)
                resize="$2"
                shift 2
                ;;
            -g|--gray)
                grayscale="1"
                shift
                ;;
            -*)
                die "Unknown option: $1"
                ;;
            *)
                inputs+=("$1")
                shift
                ;;
        esac
    done

    [[ ${#inputs[@]} -eq 0 ]] && die "Usage: lazy image batch_convert <input...> [-f format] [-q quality] [-r resize] [-g]

Batch convert images to another format.
Supports wildcards (e.g., *.png)
Output: <filename>_q<quality>[_r<resize>][_gray].<format>

Options:
  -f, --format EXT  Output format (default: jpg)
  -q, --quality N   Quality 1-100, applies to jpg/webp (default: 85)
  -r, --resize N    Resize to N% of original dimensions (e.g., 50 for half size)
  -g, --gray        Convert to grayscale"

    require_cmd convert

    local count=0
    local skipped=0

    for input in "${inputs[@]}"; do
        if [[ ! -f "$input" ]]; then
            warn "File not found: $input"
            ((++skipped))
            continue
        fi

        local basename="${input%.*}"
        local output="${basename}_q${quality}"
        if [[ -n "$resize" ]]; then
            output="${output}_r${resize}"
        fi
        if [[ -n "$grayscale" ]]; then
            output="${output}_gray"
        fi
        output="${output}.${format}"

        if [[ -f "$output" ]]; then
            warn "Skipping $input (output exists: $output)"
            ((++skipped))
            continue
        fi

        local resize_args=()
        if [[ -n "$resize" ]]; then
            resize_args=(-resize "${resize}%")
        fi

        local gray_args=()
        if [[ -n "$grayscale" ]]; then
            gray_args=(-colorspace Gray)
        fi

        img_convert "$input" "${resize_args[@]}" "${gray_args[@]}" -quality "$quality" "$output"
        success "$input -> $output"
        ((++count))
    done

    echo
    info "Converted: $count, Skipped: $skipped"
}

cmd_image() {
    local subcmd="${1:-}"
    shift || true

    case "$subcmd" in
        resize)        cmd_image_resize "$@" ;;
        convert)       cmd_image_convert "$@" ;;
        optimize)      cmd_image_optimize "$@" ;;
        batch_convert) cmd_image_batch_convert "$@" ;;
        *)
            echo "Usage: lazy image <command>

Commands:
  resize         Resize an image
  convert        Convert image format
  optimize       Optimize image file size
  batch_convert  Batch convert images to another format"
            if [[ -n "$subcmd" ]]; then
                die "Unknown command: image $subcmd"
            fi
            ;;
    esac
}

# ============================================================================
# Video Commands (using ffmpeg)
# ============================================================================

cmd_video_convert() {
    local inputs=()
    local quality="medium"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -q|--quality)
                quality="$2"
                shift 2
                ;;
            -*)
                die "Unknown option: $1"
                ;;
            *)
                inputs+=("$1")
                shift
                ;;
        esac
    done

    [[ ${#inputs[@]} -eq 0 ]] && die "Usage: lazy video convert <input...> [-q quality]

Convert videos to MP4 (H.264) with max resolution 1280x720.
Supports wildcards (e.g., *.mov)
Output: <filename>.mp4

Options:
  -q, --quality PRESET  FFmpeg preset: ultrafast, fast, medium, slow (default: medium)
                        Slower = better quality + smaller file, but longer encoding"

    require_cmd ffmpeg

    local count=0
    local skipped=0

    for input in "${inputs[@]}"; do
        if [[ ! -f "$input" ]]; then
            warn "File not found: $input"
            ((++skipped))
            continue
        fi

        local basename="${input%.*}"
        local output="${basename}.mp4"

        # Skip if input is already the output
        if [[ "$input" == "$output" ]]; then
            output="${basename}_converted.mp4"
        fi

        if [[ -f "$output" ]]; then
            warn "Skipping $input (output exists: $output)"
            ((++skipped))
            continue
        fi

        info "Converting $input -> $output"

        # Get video dimensions to determine orientation
        local dimensions
        dimensions=$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=s=x:p=0 "$input" 2>/dev/null)
        local width height
        width=$(echo "$dimensions" | cut -d'x' -f1)
        height=$(echo "$dimensions" | cut -d'x' -f2)

        # Determine max dimensions based on orientation
        local max_width max_height
        if [[ "$width" -ge "$height" ]]; then
            # Landscape or square
            max_width=1280
            max_height=720
        else
            # Portrait/vertical
            max_width=720
            max_height=1280
        fi

        # Build scale filter:
        # - Scale down if larger than max dimensions
        # - Maintain aspect ratio
        # - Ensure dimensions are divisible by 2 (required for H.264)
        local scale_filter="scale='min(${max_width},iw)':min'(${max_height},ih)':force_original_aspect_ratio=decrease,scale=trunc(iw/2)*2:trunc(ih/2)*2"

        ffmpeg -i "$input" \
            -c:v libx264 \
            -preset "$quality" \
            -crf 23 \
            -vf "$scale_filter" \
            -max_muxing_queue_size 9999
            -c:a aac \
            -b:a 128k \
            -movflags +faststart \
            -y \
            "$output" \
            2>/dev/null

        if [[ $? -eq 0 ]]; then
            local input_size output_size
            input_size=$(stat -f%z "$input" 2>/dev/null || stat -c%s "$input")
            output_size=$(stat -f%z "$output" 2>/dev/null || stat -c%s "$output")
            success "$input -> $output ($(numfmt --to=iec $input_size 2>/dev/null || echo "${input_size}B") -> $(numfmt --to=iec $output_size 2>/dev/null || echo "${output_size}B"))"
            ((++count))
        else
            error "Failed to convert $input"
            ((++skipped))
        fi
    done

    echo
    info "Converted: $count, Skipped: $skipped"
}

cmd_video() {
    local subcmd="${1:-}"
    shift || true

    case "$subcmd" in
        convert) cmd_video_convert "$@" ;;
        *)
            echo "Usage: lazy video <command>

Commands:
  convert    Convert videos to MP4 (H.264, max 720p)"
            if [[ -n "$subcmd" ]]; then
                die "Unknown command: video $subcmd"
            fi
            ;;
    esac
}

# ============================================================================
# Backup Commands (using rsync)
# ============================================================================

cmd_backup_home() {
    local volume=""
    local dry_run=""
    local last_volume
    last_volume=$(config_get "backup_last_volume" "")

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n|--dry-run)
                dry_run="--dry-run"
                shift
                ;;
            -*)
                die "Unknown option: $1"
                ;;
            *)
                volume="$1"
                shift
                ;;
        esac
    done

    # If no volume specified, suggest last used or show help
    if [[ -z "$volume" ]]; then
        if [[ -n "$last_volume" ]]; then
            echo "Last used volume: $last_volume"
            read -r -p "Use this volume? [Y/n] " response
            case "$response" in
                [nN][oO]|[nN])
                    die "Usage: lazy backup home <volume_path> [-n|--dry-run]"
                    ;;
                *)
                    volume="$last_volume"
                    ;;
            esac
        else
            die "Usage: lazy backup home <volume_path> [-n|--dry-run]

Backup home directory to an external volume using rsync.

Arguments:
  volume_path    Path to external volume (e.g., /mnt/backup, /Volumes/Backup)

Options:
  -n, --dry-run  Show what would be transferred without actually doing it"
        fi
    fi

    # Validate volume exists and is a directory
    [[ ! -d "$volume" ]] && die "Volume not found or not a directory: $volume"

    require_cmd rsync

    # Save as last used volume
    config_set "backup_last_volume" "$volume"

    # Generate log filename: "Backup_" + hostname + home_dir_name + volume_name + dry_run + .log
    local home_name
    home_name=$(basename "$HOME")
    local volume_name
    volume_name=$(basename "$volume")
    local backup_name
    backup_name=$(hostname)_${home_name}
    local log_file="$HOME/Backup_${backup_name}_${volume_name}${dry_run}.log"

    # Build exclude list for common unneeded files (macOS and Linux)
    local excludes=(
        # macOS system files
        ".DS_Store"
        ".Spotlight-V100"
        ".Trashes"
        ".fseventsd"
        ".TemporaryItems"
        ".AppleDouble"
        ".LSOverride"
        "._*"
        ".DocumentRevisions-V100"
        ".PKInstallSandboxManager"
        ".PKInstallSandboxManager-SystemSoftware"
        "Library/Logs/*"
        "Library/Application Support/CrashReporter/*"
        "Library/Application Support/MobileSync/Backup/*"
        "Library/Safari/LocalStorage/*"
        "Library/Safari/Databases/*"
        ".Trash/*"

        # Linux system files
        ".local/share/Trash/*"
        ".thumbnails/*"
        ".local/share/gvfs-metadata/*"
        ".xsession-errors*"
        ".recently-used.xbel"

        # Common development caches
        "node_modules"
        ".npm/*"
        ".pnpm-store/*"
        "__pycache__"
        ".pytest_cache"
        "*.pyc"
        ".venv/*"
        "venv/*"
        ".tox/*"
        ".mypy_cache/*"
        ".ruff_cache/*"
        "target/debug/*"
        "target/release/*"
        ".cargo/registry/*"
        ".gradle/*"
        ".m2/repository/*"

        # IDE and editor caches
        ".vscode/extensions/*"

        # Cache folders
        "cache/"
        ".cache/"
        "**Cache/"
        "caches/"
        "cached/"
        "Caches/"
        "Cache[A-Z]**" #CacheStorage and similar
        "Cached[A-Z]**" #CachedData and similar
        "htmlcache/"
        "librarycache/"
        "appcache/"
        "*.cache"
        "*-cache"

        # Docker
        ".docker/buildx/*"

        # Misc
        "*.log"
        "*.tmp"
        ".git/objects/*"
    )

    local exclude_args=()
    for pattern in "${excludes[@]}"; do
        exclude_args+=(--exclude="$pattern")
    done

    info "Backing up $HOME -> $volume"
    if [[ -n "$dry_run" ]]; then
        warn "DRY RUN - no files will be transferred"
    fi
    info "Log file: $log_file"
    echo

    # Run rsync with archive mode, delete, and exclusions
    rsync -av --delete \
        "${exclude_args[@]}" \
        $dry_run \
        "$HOME/" \
        "${volume}/Backup/${backup_name}/" \
        2>&1 | tee "$log_file"

    local rsync_status=${PIPESTATUS[0]}

    echo
    if [[ $rsync_status -eq 0 ]]; then
        success "Backup completed successfully"
        info "Log saved to: $log_file"
    else
        error "Backup completed with errors (exit code: $rsync_status)"
        info "Check log for details: $log_file"
    fi
}

cmd_backup() {
    local subcmd="${1:-}"
    shift || true

    case "$subcmd" in
        home) cmd_backup_home "$@" ;;
        *)
            echo "Usage: lazy backup <command>

Commands:
  home    Backup home directory to external volume"
            if [[ -n "$subcmd" ]]; then
                die "Unknown command: backup $subcmd"
            fi
            ;;
    esac
}

# ============================================================================
# Check/Doctor Commands
# ============================================================================

cmd_doctor() {
    echo "lazy v$VERSION - System Check"
    echo "=============================="
    echo

    local os=$(detect_os)
    echo "OS: $os"
    echo

    echo "Dependencies:"

    # Check ghostscript
    if command -v gs &> /dev/null; then
        local gs_version=$(gs --version 2>/dev/null || echo "unknown")
        success "ghostscript $gs_version"
    else
        error "ghostscript not installed"
    fi

    # Check imagemagick
    if command -v convert &> /dev/null; then
        local im_version=$(convert --version 2>/dev/null | head -1 | awk '{print $3}' || echo "unknown")
        success "imagemagick $im_version"
    else
        error "imagemagick not installed"
    fi

    # Check rsync
    if command -v rsync &> /dev/null; then
        local rsync_version
        rsync_version=$(set +o pipefail; rsync --version 2>/dev/null | head -1 | awk '{for(i=1;i<=NF;i++) if($i~/^[0-9]+\.[0-9]+/) {print $i; exit}}')
        [[ -z "$rsync_version" ]] && rsync_version="unknown"
        success "rsync $rsync_version"
    else
        error "rsync not installed"
    fi

    # Check ffmpeg
    if command -v ffmpeg &> /dev/null; then
        local ffmpeg_version
        ffmpeg_version=$(ffmpeg -version 2>/dev/null | head -1 | awk '{print $3}')
        [[ -z "$ffmpeg_version" ]] && ffmpeg_version="unknown"
        success "ffmpeg $ffmpeg_version"
    else
        error "ffmpeg not installed"
    fi

    echo
    echo "Run 'make install-deps' to install missing dependencies."
}

# ============================================================================
# Main
# ============================================================================

show_help() {
    cat <<EOF
lazy v$VERSION - A CLI for common file operations

Usage: lazy <command> [options]

Commands:
  pdf       PDF operations (compress, merge)
  image     Image operations (resize, convert, optimize, batch_convert)
  video     Video operations (convert to MP4)
  backup    Backup operations (home)
  doctor    Check system dependencies

Examples:
  lazy pdf compress document.pdf -q ebook
  lazy pdf merge file1.pdf file2.pdf -o merged.pdf
  lazy image resize photo.jpg -w 800
  lazy image convert photo.png -o photo.webp
  lazy image optimize photo.jpg -q 80
  lazy image batch_convert *.png -f webp -q 90
  lazy video convert *.mov
  lazy backup home /mnt/external

Run 'lazy <command>' for command-specific help.
EOF
}

main() {
    local cmd="${1:-}"
    shift || true

    case "$cmd" in
        pdf)     cmd_pdf "$@" ;;
        image)   cmd_image "$@" ;;
        video)   cmd_video "$@" ;;
        backup)  cmd_backup "$@" ;;
        doctor)  cmd_doctor ;;
        version) echo "lazy v$VERSION" ;;
        help|--help|-h|"")
            show_help
            ;;
        *)
            die "Unknown command: $cmd. Run 'lazy help' for usage."
            ;;
    esac
}

main "$@"
