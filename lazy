#!/usr/bin/env bash
#
# lazy - A CLI tool for common file operations using ghostscript and imagemagick
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERSION="0.4.0"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Helper functions
info() { echo -e "${BLUE}[INFO]${NC} $*"; }
success() { echo -e "${GREEN}[OK]${NC} $*"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }
die() { error "$*"; exit 1; }

# Check if a command exists
require_cmd() {
    local cmd="$1"
    if ! command -v "$cmd" &> /dev/null; then
        die "$cmd is not installed. Run 'make install-deps' to install dependencies."
    fi
}

# Return a non-conflicting output path using the macOS Finder convention:
# "foo.ext" if free, otherwise "foo 2.ext", "foo 3.ext", ... This lets every
# command write output without ever prompting or clobbering an existing file.
unique_path() {
    local path="$1"
    [[ ! -e "$path" ]] && { printf '%s\n' "$path"; return; }
    local dir base name ext n=2
    dir="$(dirname "$path")"
    base="$(basename "$path")"
    if [[ "$base" == *.* ]]; then
        name="${base%.*}"
        ext=".${base##*.}"
    else
        name="$base"
        ext=""
    fi
    while [[ -e "$dir/$name $n$ext" ]]; do
        ((n++))
    done
    printf '%s\n' "$dir/$name $n$ext"
}

# Detect OS
detect_os() {
    case "$(uname -s)" in
        Darwin*) echo "macos" ;;
        Linux*)  echo "linux" ;;
        *)       echo "unknown" ;;
    esac
}

# Resolve the ImageMagick CLI binary once: prefer `magick` (ImageMagick 7),
# fall back to `convert` (ImageMagick 6, where `magick` does not exist).
if command -v magick &> /dev/null; then
    MAGICK="magick"
else
    MAGICK="convert"
fi

# Imagemagick wrapper with common parameters
# Usage: img_convert <input> [options...] <output>
# Applies: -strip (remove metadata), -interlace Plane (progressive loading)
# The common options go *after* the input: under ImageMagick 7 `-strip` is an
# image operator and errors if it appears before any image is loaded.
img_convert() {
    local input="$1"
    shift
    "$MAGICK" "$input" -strip -interlace Plane "$@"
}

# Config file management
CONFIG_DIR="${HOME}/.config/lazy"
CONFIG_FILE="${CONFIG_DIR}/config"

config_get() {
    local key="$1"
    local default="${2:-}"
    if [[ -f "$CONFIG_FILE" ]]; then
        local value
        value=$(grep "^${key}=" "$CONFIG_FILE" 2>/dev/null | cut -d'=' -f2-)
        if [[ -n "$value" ]]; then
            echo "$value"
            return
        fi
    fi
    echo "$default"
}

config_set() {
    local key="$1"
    local value="$2"
    mkdir -p "$CONFIG_DIR"
    if [[ -f "$CONFIG_FILE" ]] && grep -q "^${key}=" "$CONFIG_FILE" 2>/dev/null; then
        # Update existing key
        sed -i.bak "s|^${key}=.*|${key}=${value}|" "$CONFIG_FILE" && rm -f "${CONFIG_FILE}.bak"
    else
        # Add new key
        echo "${key}=${value}" >> "$CONFIG_FILE"
    fi
}

# ============================================================================
# PDF Commands (using ghostscript)
# ============================================================================

cmd_pdf_compress() {
    local input=""
    local output=""
    local quality="ebook"  # screen, ebook, printer, prepress

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -q|--quality)
                quality="$2"
                shift 2
                ;;
            -o|--output)
                output="$2"
                shift 2
                ;;
            -*)
                die "Unknown option: $1"
                ;;
            *)
                input="$1"
                shift
                ;;
        esac
    done

    [[ -z "$input" ]] && die "Usage: lazy pdf compress <input.pdf> [-o output.pdf] [-q quality]

Quality options:
  screen   - lowest quality, smallest size (72 dpi)
  ebook    - medium quality, good for reading (150 dpi) [default]
  printer  - high quality for printing (300 dpi)
  prepress - highest quality, preserves color (300 dpi)"

    [[ ! -f "$input" ]] && die "File not found: $input"

    require_cmd gs

    # Default output name
    if [[ -z "$output" ]]; then
        local basename="${input%.*}"
        local ext="${input##*.}"
        output="${basename}_compressed.${ext}"
    fi

    output="$(unique_path "$output")"

    info "Compressing $input -> $output (quality: $quality)"

    gs -sDEVICE=pdfwrite \
       -dCompatibilityLevel=1.4 \
       -dPDFSETTINGS="/$quality" \
       -dNOPAUSE \
       -dQUIET \
       -dBATCH \
       -sOutputFile="$output" \
       "$input"

    local input_size=$(stat -f%z "$input" 2>/dev/null || stat -c%s "$input")
    local output_size=$(stat -f%z "$output" 2>/dev/null || stat -c%s "$output")
    local reduction=$(( (input_size - output_size) * 100 / input_size ))

    success "Compressed: $(numfmt --to=iec $input_size 2>/dev/null || echo "${input_size} bytes") -> $(numfmt --to=iec $output_size 2>/dev/null || echo "${output_size} bytes") (${reduction}% reduction)"
}

cmd_pdf_merge() {
    local output=""
    local inputs=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -o|--output)
                output="$2"
                shift 2
                ;;
            -*)
                die "Unknown option: $1"
                ;;
            *)
                inputs+=("$1")
                shift
                ;;
        esac
    done

    [[ ${#inputs[@]} -lt 2 ]] && die "Usage: lazy pdf merge <input1.pdf> <input2.pdf> ... -o output.pdf"
    [[ -z "$output" ]] && die "Output file required. Use -o <output.pdf>"

    require_cmd gs
    output="$(unique_path "$output")"

    info "Merging ${#inputs[@]} PDFs -> $output"

    gs -dBATCH \
       -dNOPAUSE \
       -dQUIET \
       -sDEVICE=pdfwrite \
       -sOutputFile="$output" \
       "${inputs[@]}"

    success "Created $output"
}

cmd_pdf() {
    local subcmd="${1:-}"
    shift || true

    case "$subcmd" in
        compress) cmd_pdf_compress "$@" ;;
        merge)    cmd_pdf_merge "$@" ;;
        *)
            echo "Usage: lazy pdf <command>

Commands:
  compress   Compress a PDF file
  merge      Merge multiple PDF files"
            if [[ -n "$subcmd" ]]; then
                die "Unknown command: pdf $subcmd"
            fi
            ;;
    esac
}

# ============================================================================
# Image Commands (using imagemagick)
# ============================================================================

cmd_image_convert() {
    local quality="85"
    local format="jpg"
    local resize=""
    local size=""
    local width=""
    local height=""
    local grayscale=""
    local output=""
    local inputs=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -q|--quality)
                quality="$2"
                shift 2
                ;;
            -f|--format)
                format="$2"
                shift 2
                ;;
            -r|--resize)
                resize="$2"
                shift 2
                ;;
            -s|--size)
                size="$2"
                shift 2
                ;;
            -w|--width)
                width="$2"
                shift 2
                ;;
            -h|--height)
                height="$2"
                shift 2
                ;;
            -g|--gray)
                grayscale="1"
                shift
                ;;
            -o|--output)
                output="$2"
                shift 2
                ;;
            -*)
                die "Unknown option: $1"
                ;;
            *)
                inputs+=("$1")
                shift
                ;;
        esac
    done

    [[ ${#inputs[@]} -eq 0 ]] && die "Usage: lazy image convert <input...> [-f format] [-q quality] [resize] [-g] [-o output]

Convert and/or resize one or more images. Supports wildcards (e.g., *.png).
Default output: <filename>_q<quality>[<resize>][_gray].<format> (never overwrites;
a numbered suffix is added on conflict).

Options:
  -f, --format EXT   Output format (default: jpg)
  -q, --quality N    Quality 1-100, applies to jpg/webp (default: 85)
  -g, --gray         Convert to grayscale
  -o, --output FILE  Explicit output path (single input only; its extension sets the format)

Resize (choose at most one; percentage cannot be combined with exact size):
  -r, --resize N     Scale to N% of original (e.g., 50 for half size)
  -s, --size WxH     Resize to exact dimensions, ignoring aspect ratio (e.g., 800x600)
  -w, --width N      Resize to width, maintain aspect ratio
  -h, --height N     Resize to height, maintain aspect ratio"

    # A percentage resize and an exact-pixel resize can't be combined.
    if [[ -n "$resize" && ( -n "$size" || -n "$width" || -n "$height" ) ]]; then
        die "Cannot combine percentage resize (-r) with exact size (-s/-w/-h)"
    fi

    # An explicit output path only makes sense for a single input.
    if [[ -n "$output" && ${#inputs[@]} -gt 1 ]]; then
        die "-o/--output is only supported with a single input file"
    fi

    require_cmd "$MAGICK"

    # Build the resize filter and a matching filename marker (precedence s > w > h).
    local resize_args=() resize_marker=""
    if [[ -n "$resize" ]]; then
        resize_args=(-resize "${resize}%"); resize_marker="_r${resize}"
    elif [[ -n "$size" ]]; then
        resize_args=(-resize "${size}!"); resize_marker="_${size}"
    elif [[ -n "$width" ]]; then
        resize_args=(-resize "${width}x"); resize_marker="_w${width}"
    elif [[ -n "$height" ]]; then
        resize_args=(-resize "x${height}"); resize_marker="_h${height}"
    fi

    local gray_args=() gray_marker=""
    if [[ -n "$grayscale" ]]; then
        gray_args=(-colorspace Gray); gray_marker="_gray"
    fi

    local count=0
    local skipped=0

    for input in "${inputs[@]}"; do
        if [[ ! -f "$input" ]]; then
            warn "File not found: $input"
            ((++skipped))
            continue
        fi

        local out
        if [[ -n "$output" ]]; then
            out="$output"
        else
            local basename="${input%.*}"
            out="${basename}_q${quality}${resize_marker}${gray_marker}.${format}"
        fi
        out="$(unique_path "$out")"

        img_convert "$input" "${resize_args[@]+"${resize_args[@]}"}" "${gray_args[@]+"${gray_args[@]}"}" -quality "$quality" "$out"
        success "$input -> $out"
        ((++count))
    done

    echo
    info "Converted: $count, Skipped: $skipped"
    # Nothing produced (e.g. every input was missing) is a failure.
    [[ $count -eq 0 ]] && exit 1
    return 0
}

cmd_image() {
    local subcmd="${1:-}"
    shift || true

    case "$subcmd" in
        convert) cmd_image_convert "$@" ;;
        *)
            echo "Usage: lazy image <command>

Commands:
  convert  Convert and/or resize one or more images"
            if [[ -n "$subcmd" ]]; then
                die "Unknown command: image $subcmd"
            fi
            ;;
    esac
}

# ============================================================================
# Video Commands (using ffmpeg)
# ============================================================================

cmd_video_convert() {
    local inputs=()
    local mode="balanced"
    local codec="h265"
    local resolution="input"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -m|--mode)
                mode="$2"
                shift 2
                ;;
            -c|--codec)
                codec="$2"
                shift 2
                ;;
            -r|--resolution)
                resolution="$2"
                shift 2
                ;;
            -*)
                die "Unknown option: $1"
                ;;
            *)
                inputs+=("$1")
                shift
                ;;
        esac
    done

    [[ ${#inputs[@]} -eq 0 ]] && die "Usage: lazy video convert <input...> [-m mode] [-c codec] [-r resolution]

Convert videos to MP4, preserving aspect ratio for both landscape and portrait.
Supports wildcards (e.g., *.mov). Output: <filename>_<codec>[_<resolution>].mp4
(never overwrites; a numbered suffix is added on conflict).

Modes (-m, --mode):
  balanced   preset slow    Good for ~90% of cases (default)
  small      preset slow    More aggressive compression, smaller files
  quality    preset slower  Higher picture quality, longer encoding

The CRF (quality target) is tuned per codec, since H.265 needs a higher CRF than
H.264 for equivalent quality. Lower CRF = higher quality + larger file.

Codec (-c, --codec):    h265 (HEVC, smaller; default) or h264 (more compatible)
Resolution (-r):        input (keep original; default), 4k, 1080p, or 720p
                        (scales down only, never up; aspect ratio preserved)

Audio: balanced/quality copy the original audio stream losslessly (falling back
to AAC 192k if the source codec isn't MP4-compatible); small re-encodes to AAC 128k."

    # Map codec to the ffmpeg video encoder args.
    local video_args
    case "$codec" in
        h265) video_args=(-c:v libx265 -pix_fmt yuv420p -tag:v hvc1) ;;
        h264) video_args=(-c:v libx264 -pix_fmt yuv420p) ;;
        *) die "Unknown codec: $codec (expected: h265, h264)" ;;
    esac

    # Map mode to preset + CRF. x264 and x265 use different CRF scales (x265
    # needs a higher CRF for the same quality, roughly +5), so each codec gets
    # its own value tuned to the same visual target.
    local crf preset
    case "$mode" in
        balanced) preset="slow";   [[ "$codec" == "h264" ]] && crf=23 || crf=28 ;;
        small)    preset="slow";   [[ "$codec" == "h264" ]] && crf=27 || crf=32 ;;
        quality)  preset="slower"; [[ "$codec" == "h264" ]] && crf=19 || crf=24 ;;
        *) die "Unknown mode: $mode (expected: balanced, small, quality)" ;;
    esac

    # Map resolution preset to landscape max dimensions ("" = keep original).
    local res_max_w res_max_h
    case "$resolution" in
        input) res_max_w=""; res_max_h="" ;;
        4k)    res_max_w=3840; res_max_h=2160 ;;
        1080p) res_max_w=1920; res_max_h=1080 ;;
        720p)  res_max_w=1280; res_max_h=720 ;;
        *) die "Unknown resolution: $resolution (expected: input, 4k, 1080p, 720p)" ;;
    esac

    require_cmd ffmpeg

    local res_suffix=""
    [[ "$resolution" != "input" ]] && res_suffix="_${resolution}"

    local count=0
    local skipped=0

    for input in "${inputs[@]}"; do
        if [[ ! -f "$input" ]]; then
            warn "File not found: $input"
            ((++skipped))
            continue
        fi

        local basename="${input%.*}"
        local output="${basename}_${codec}${res_suffix}.mp4"
        output="$(unique_path "$output")"

        # Decide how to handle audio.
        #   small           -> always re-encode to AAC 128k (aggressive)
        #   balanced/quality -> copy the original stream losslessly when it is a
        #                       codec MP4/QuickTime can play, otherwise fall back
        #                       to high-quality AAC so the output stays playable.
        local audio_args=()
        local source_audio
        source_audio=$(ffprobe -v error -select_streams a:0 -show_entries stream=codec_name -of csv=p=0 "$input" 2>/dev/null)

        if [[ -z "$source_audio" ]]; then
            # No audio stream present.
            audio_args=(-an)
        elif [[ "$mode" == "small" ]]; then
            audio_args=(-c:a aac -b:a 128k)
        else
            case "$source_audio" in
                aac|ac3|eac3|mp3|alac)
                    # MP4/QuickTime-compatible: keep the original stream as-is.
                    audio_args=(-c:a copy)
                    ;;
                *)
                    # e.g. opus, vorbis, dts, pcm_* — not reliably playable in MP4,
                    # transcode to high-quality AAC instead.
                    warn "Audio codec '$source_audio' isn't MP4/QuickTime-safe; re-encoding to AAC 192k"
                    audio_args=(-c:a aac -b:a 192k)
                    ;;
            esac
        fi

        # Build the scale filter. Always force even dimensions (required for
        # yuv420p / H.264 / H.265). When a resolution cap is requested, scale
        # down within it while preserving aspect ratio, orienting the cap to the
        # video (portrait clips get the dimensions swapped).
        local scale_filter="scale=trunc(iw/2)*2:trunc(ih/2)*2"
        if [[ -n "$res_max_w" ]]; then
            local dimensions width height
            dimensions=$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=s=x:p=0 "$input" 2>/dev/null)
            width=$(echo "$dimensions" | cut -d'x' -f1)
            height=$(echo "$dimensions" | cut -d'x' -f2)

            local max_w max_h
            if [[ -n "$width" && -n "$height" && "$width" -lt "$height" ]]; then
                # Portrait/vertical: swap the cap.
                max_w="$res_max_h"; max_h="$res_max_w"
            else
                # Landscape or square (also the fallback if probing failed).
                max_w="$res_max_w"; max_h="$res_max_h"
            fi
            scale_filter="scale='min(${max_w},iw)':'min(${max_h},ih)':force_original_aspect_ratio=decrease,scale=trunc(iw/2)*2:trunc(ih/2)*2"
        fi

        info "Converting $input -> $output (codec: $codec, mode: $mode, crf $crf, preset $preset, resolution: $resolution)"

        ffmpeg -i "$input" \
            "${video_args[@]}" \
            -preset "$preset" \
            -crf "$crf" \
            -vf "$scale_filter" \
            -max_muxing_queue_size 9999 \
            "${audio_args[@]}" \
            -movflags +faststart \
            -y \
            "$output" \
            2>/dev/null

        if [[ $? -eq 0 ]]; then
            local input_size output_size
            input_size=$(stat -f%z "$input" 2>/dev/null || stat -c%s "$input")
            output_size=$(stat -f%z "$output" 2>/dev/null || stat -c%s "$output")
            success "$input -> $output ($(numfmt --to=iec $input_size 2>/dev/null || echo "${input_size}B") -> $(numfmt --to=iec $output_size 2>/dev/null || echo "${output_size}B"))"
            ((++count))
        else
            error "Failed to convert $input"
            ((++skipped))
        fi
    done

    echo
    info "Converted: $count, Skipped: $skipped"
    # Nothing produced (e.g. every input failed or was missing) is a failure.
    [[ $count -eq 0 ]] && exit 1
    return 0
}

cmd_video() {
    local subcmd="${1:-}"
    shift || true

    case "$subcmd" in
        convert) cmd_video_convert "$@" ;;
        *)
            echo "Usage: lazy video <command>

Commands:
  convert  Convert videos to MP4 (H.265/H.264, optional resolution cap)"
            if [[ -n "$subcmd" ]]; then
                die "Unknown command: video $subcmd"
            fi
            ;;
    esac
}

# ============================================================================
# Backup Commands (using rsync)
# ============================================================================

cmd_backup_home() {
    local volume=""
    local dry_run=""
    local last_volume
    last_volume=$(config_get "backup_last_volume" "")

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n|--dry-run)
                dry_run="--dry-run"
                shift
                ;;
            -*)
                die "Unknown option: $1"
                ;;
            *)
                volume="$1"
                shift
                ;;
        esac
    done

    # If no volume specified, suggest last used or show help
    if [[ -z "$volume" ]]; then
        if [[ -n "$last_volume" ]]; then
            echo "Last used volume: $last_volume"
            read -r -p "Use this volume? [Y/n] " response
            case "$response" in
                [nN][oO]|[nN])
                    die "Usage: lazy backup home <volume_path> [-n|--dry-run]"
                    ;;
                *)
                    volume="$last_volume"
                    ;;
            esac
        else
            die "Usage: lazy backup home <volume_path> [-n|--dry-run]

Backup home directory to an external volume using rsync.

Arguments:
  volume_path    Path to external volume (e.g., /mnt/backup, /Volumes/Backup)

Options:
  -n, --dry-run  Show what would be transferred without actually doing it"
        fi
    fi

    # Validate volume exists and is a directory
    [[ ! -d "$volume" ]] && die "Volume not found or not a directory: $volume"

    require_cmd rsync

    # Save as last used volume
    config_set "backup_last_volume" "$volume"

    # Generate log filename: "Backup_" + hostname + home_dir_name + volume_name + dry_run + .log
    local home_name
    home_name=$(basename "$HOME")
    local volume_name
    volume_name=$(basename "$volume")
    local backup_name
    backup_name=$(hostname)_${home_name}
    local log_file="$HOME/Backup_${backup_name}_${volume_name}${dry_run}.log"

    # Build exclude list for common unneeded files (macOS and Linux)
    local excludes=(
        # macOS system files
        ".DS_Store"
        ".Spotlight-V100"
        ".Trashes"
        ".fseventsd"
        ".TemporaryItems"
        ".AppleDouble"
        ".LSOverride"
        "._*"
        ".DocumentRevisions-V100"
        ".PKInstallSandboxManager"
        ".PKInstallSandboxManager-SystemSoftware"
        "Library/Logs/*"
        "Library/Application Support/CrashReporter/*"
        "Library/Application Support/MobileSync/Backup/*"
        "Library/Safari/LocalStorage/*"
        "Library/Safari/Databases/*"
        ".Trash/*"

        # Linux system files
        ".local/share/Trash/*"
        ".thumbnails/*"
        ".local/share/gvfs-metadata/*"
        ".xsession-errors*"
        ".recently-used.xbel"

        # Common development caches
        "node_modules"
        ".npm/*"
        ".pnpm-store/*"
        "__pycache__"
        ".pytest_cache"
        "*.pyc"
        ".venv/*"
        "venv/*"
        ".tox/*"
        ".mypy_cache/*"
        ".ruff_cache/*"
        "target/debug/*"
        "target/release/*"
        ".cargo/registry/*"
        ".gradle/*"
        ".m2/repository/*"

        # IDE and editor caches
        ".vscode/extensions/*"

        # Cache folders
        "cache/"
        ".cache/"
        "**Cache/"
        "caches/"
        "cached/"
        "Caches/"
        "Cache[A-Z]**" #CacheStorage and similar
        "Cached[A-Z]**" #CachedData and similar
        "htmlcache/"
        "librarycache/"
        "appcache/"
        "*.cache"
        "*-cache"

        # Docker
        ".docker/buildx/*"

        # Misc
        "*.log"
        "*.tmp"
        ".git/objects/*"
    )

    local exclude_args=()
    for pattern in "${excludes[@]}"; do
        exclude_args+=(--exclude="$pattern")
    done

    info "Backing up $HOME -> $volume"
    if [[ -n "$dry_run" ]]; then
        warn "DRY RUN - no files will be transferred"
    fi
    info "Log file: $log_file"
    echo

    # rsync only creates the final destination component, so ensure the full
    # path exists (a fresh volume has no Backup/ dir). Skip on dry runs to
    # avoid touching the destination.
    if [[ -z "$dry_run" ]]; then
        mkdir -p "${volume}/Backup/${backup_name}"
    fi

    # Run rsync with archive mode, delete, and exclusions.
    # Disable errexit around the pipeline: rsync legitimately returns non-zero
    # for partial transfers (e.g. 23/24 when some files are unreadable), and we
    # want to report that gracefully rather than have `set -e` abort the script.
    set +e
    rsync -av --delete \
        "${exclude_args[@]}" \
        $dry_run \
        "$HOME/" \
        "${volume}/Backup/${backup_name}/" \
        2>&1 | tee "$log_file"
    local rsync_status=${PIPESTATUS[0]}
    set -e

    echo
    if [[ $rsync_status -eq 0 ]]; then
        success "Backup completed successfully"
        info "Log saved to: $log_file"
    else
        error "Backup completed with errors (exit code: $rsync_status)"
        info "Check log for details: $log_file"
    fi
}

cmd_backup() {
    local subcmd="${1:-}"
    shift || true

    case "$subcmd" in
        home) cmd_backup_home "$@" ;;
        *)
            echo "Usage: lazy backup <command>

Commands:
  home    Backup home directory to external volume"
            if [[ -n "$subcmd" ]]; then
                die "Unknown command: backup $subcmd"
            fi
            ;;
    esac
}

# ============================================================================
# Check/Doctor Commands
# ============================================================================

cmd_doctor() {
    echo "lazy v$VERSION - System Check"
    echo "=============================="
    echo

    local os=$(detect_os)
    echo "OS: $os"
    echo

    echo "Dependencies:"

    # Check ghostscript
    if command -v gs &> /dev/null; then
        local gs_version=$(gs --version 2>/dev/null || echo "unknown")
        success "ghostscript $gs_version"
    else
        error "ghostscript not installed"
    fi

    # Check imagemagick (magick on IM7, convert on IM6)
    if command -v "$MAGICK" &> /dev/null; then
        local im_version=$("$MAGICK" --version 2>/dev/null | head -1 | awk '{print $3}' || echo "unknown")
        success "imagemagick $im_version ($MAGICK)"
    else
        error "imagemagick not installed"
    fi

    # Check rsync
    if command -v rsync &> /dev/null; then
        local rsync_version
        rsync_version=$(set +o pipefail; rsync --version 2>/dev/null | head -1 | awk '{for(i=1;i<=NF;i++) if($i~/^[0-9]+\.[0-9]+/) {print $i; exit}}')
        [[ -z "$rsync_version" ]] && rsync_version="unknown"
        success "rsync $rsync_version"
    else
        error "rsync not installed"
    fi

    # Check ffmpeg
    if command -v ffmpeg &> /dev/null; then
        local ffmpeg_version
        ffmpeg_version=$(ffmpeg -version 2>/dev/null | head -1 | awk '{print $3}')
        [[ -z "$ffmpeg_version" ]] && ffmpeg_version="unknown"
        success "ffmpeg $ffmpeg_version"
    else
        error "ffmpeg not installed"
    fi

    echo
    echo "Run 'make install-deps' to install missing dependencies."
}

# ============================================================================
# Main
# ============================================================================

show_help() {
    cat <<EOF
lazy v$VERSION - A CLI for common file operations

Usage: lazy <command> [options]

Commands:
  pdf       PDF operations (compress, merge)
  image     Image operations (convert/resize)
  video     Video operations (convert to MP4)
  backup    Backup operations (home)
  doctor    Check system dependencies

Examples:
  lazy pdf compress document.pdf -q ebook
  lazy pdf merge file1.pdf file2.pdf -o merged.pdf
  lazy image convert *.png -f webp -q 90
  lazy image convert photo.jpg -w 800
  lazy image convert logo.png -o logo.webp
  lazy video convert *.mov
  lazy video convert *.mov -c h264 -r 1080p
  lazy backup home /mnt/external

Run 'lazy <command>' for command-specific help.
EOF
}

main() {
    local cmd="${1:-}"
    shift || true

    case "$cmd" in
        pdf)     cmd_pdf "$@" ;;
        image)   cmd_image "$@" ;;
        video)   cmd_video "$@" ;;
        backup)  cmd_backup "$@" ;;
        doctor)  cmd_doctor ;;
        version) echo "lazy v$VERSION" ;;
        help|--help|-h|"")
            show_help
            ;;
        *)
            die "Unknown command: $cmd. Run 'lazy help' for usage."
            ;;
    esac
}

main "$@"
